{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "${mod_homepage}",
        "sources": "${mod_source}",
        "issues": "${mod_issues}"
    },
    "license": "${license}",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "*",
    "entrypoints": {
        "client": [
            "tallestred.blockplaceparticles.FabricClientEntrypoint"
        ],
        "modmenu": [
            "tallestred.blockplaceparticles.ModMenuIntegration"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16.0",
        "fabric-api": "*",
        "minecraft": ["1.20","1.20.1"],
        "java": ">=${java_version}",
        "yet_another_config_lib_v3": ">=${yacl_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  